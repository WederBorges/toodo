SECRET_KEY=sua_chave_secreta_aqui
DATABASE_URL=postgresql://usuario:senha@host:porta/banco
RESEND_API_KEY=sua_api_key_resend
RESEND_FROM=notificacoes@seudominio.com

# Nunca deixe true em produção: habilita o debugger interativo do Werkzeug.
FLASK_DEBUG=false

# Opcional: limite de tamanho do corpo das requisições, em bytes (padrão 2MB).
MAX_CONTENT_LENGTH=2097152

# Opcional: backend de armazenamento do rate limit (Flask-Limiter).
# Use memory:// para um único worker, ou uma URL Redis (redis://host:porta/0)
# quando rodar com múltiplos workers/instâncias.
RATE_LIMIT_STORAGE_URI=memory://
